# ╔══════════════════════════════════════════════════════════╗
# ║   My-Agent-Mini v5 — Built-in smart AI router             ║
# ║   Copy this to .env and fill in Slack keys               ║
# ╚══════════════════════════════════════════════════════════╝

# ── SLACK (required — how the bot connects to Slack) ──
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# ── KEYLESS BEST-EFFORT ROUTE (enabled by default) ──
# Pollinations provides an anonymous community route. It may be slow,
# rate-limited, or unavailable; it is not guaranteed or unlimited.
POLLINATIONS_ENABLED=true
POLLINATIONS_MODEL=openai-fast
# Keep true so an old/expired provider key cannot block the free route.
ROUTER_PREFER_KEYLESS=true

# ── BOT SETTINGS (optional) ──
BOT_NAME=My Agent
MAX_HISTORY=10
ROUTER_COOLDOWN_SECONDS=90
# Slack reaction shown while the bot is thinking; use "" to disable.
LOADING_REACTION=hourglass_flowing_sand

# ── OPTIONAL PRIMARY/BACKUP PROVIDER KEYS ──
# Add free keys here only if you want stronger reliability. The built-in
# router tries healthy routes and automatically cools down failed ones.
# NVIDIA_API_KEY=nvapi-your-key
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ── MERGE GATEWAY (optional paid gateway) ──
# Get the mg_... key from https://gateway.merge.dev
# The $10 credit is consumed according to the provider/model you select.
# MERGE_GATEWAY_API_KEY=mg_your_key
# MERGE_GATEWAY_MODEL=openai/gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# OPTIONAL BACKUP BRAINS (leave empty = disabled)
# If NVIDIA ever fails or runs out of free calls, add one of
# these and the bot will use it automatically as backup:
#
# GROQ_API_KEY=          (free: https://console.groq.com/keys)
# MISTRAL_API_KEY=       (free: https://console.mistral.ai/api-keys)
# SAMBANOVA_API_KEY=     (free: https://cloud.sambanova.ai)
# ─────────────────────────────────────────────────────────────

# ── OWNER LOCK (required once the bot is reachable by more than just you) ──
# Your Slack user ID. Tools that change external state on your behalf
# (github_write_file, github_create_issue, restart_service,
# deploy_static_site, push_branch) only run for this Slack user — anyone
# else gets a polite refusal instead of the tool executing with your
# credentials.
# Find your ID in Slack: profile -> More -> Copy member ID.
# OWNER_SLACK_ID=U0XXXXXXX

# ── SKILLS: GITHUB AUTOMATION + CODING WORKSPACE (optional) ──
# A fine-grained personal access token (repo contents + issues read/write)
# lets the agent read files/issues via the API and propose changes as a
# pull request (it never commits straight to main) — for a single file via
# github_write_file, or for a whole cloned repo via clone_repo + push_branch
# (needed because plain `git push` has no credential helper on this server;
# push_branch authenticates the push itself without storing the token
# anywhere on disk).
# GITHUB_TOKEN=github_pat_your_token
# GITHUB_DEFAULT_OWNER=your-github-username
# GITHUB_DEFAULT_REPO=your-default-repo

# ── SKILLS: SERVER ADMINISTRATION (optional) ──
# Comma-separated systemd services the agent is allowed to restart via the
# restart_service tool. Requires passwordless sudo for exactly this command,
# e.g. via: sudo visudo -f /etc/sudoers.d/my-agent
#   denis94uk ALL=(ALL) NOPASSWD: /bin/systemctl restart my-agent.service
# ALLOWED_SERVICES=my-agent.service

# ── SKILLS: WEBSITE BUILDING (optional) ──
# Personal token from https://vercel.com/account/tokens — lets
# deploy_static_site ship scaffolded static sites live.
# VERCEL_TOKEN=your-vercel-token
# ─────────────────────────────────────────────────────────────
