# ╔══════════════════════════════════════════════════════════╗
# ║   My-Agent-Mini v4 — Clean Setup: 1 AI Brain Only        ║
# ║   Copy this to .env and fill in your 3 keys              ║
# ╚══════════════════════════════════════════════════════════╝

# ── SLACK (required — how the bot connects to Slack) ──
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# ── THE AI BRAIN: NVIDIA NIM (required) ──
# Get key: https://build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=nvapi-your-key
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ── BOT SETTINGS (optional) ──
BOT_NAME=My Agent
MAX_HISTORY=10

# ─────────────────────────────────────────────────────────────
# OPTIONAL BACKUP BRAINS (leave empty = disabled)
# If NVIDIA ever fails or runs out of free calls, add one of
# these and the bot will use it automatically as backup:
#
# GROQ_API_KEY=          (free: https://console.groq.com/keys)
# MISTRAL_API_KEY=       (free: https://console.mistral.ai/api-keys)
# SAMBANOVA_API_KEY=     (free: https://cloud.sambanova.ai)
# ─────────────────────────────────────────────────────────────
