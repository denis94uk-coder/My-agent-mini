# ╔══════════════════════════════════════════════════════════╗
# ║   My-Agent-Mini v5 — Built-in smart AI router             ║
# ║   Copy this to .env and fill in Slack keys               ║
# ╚══════════════════════════════════════════════════════════╝

# ── SLACK (required — how the bot connects to Slack) ──
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# ── KEYLESS BEST-EFFORT ROUTE (enabled by default) ──
# Pollinations provides an anonymous community route. It may be slow,
# rate-limited, or unavailable; it is not guaranteed or unlimited.
POLLINATIONS_ENABLED=true
POLLINATIONS_MODEL=openai-fast
# Keep true so an old/expired provider key cannot block the free route.
# Ignored for any route named in ROUTER_ORDER below.
ROUTER_PREFER_KEYLESS=true
# Which free route to try first, by substring. Without this the order is
# whichever provider block happens to come first in build_providers, which is
# not a preference — put your fastest or most generous route at the front.
# Routes you leave out keep their existing order behind the ones you name.
# Paid routes are still tried last whatever this says.
# ROUTER_ORDER=groq,gemini,pollinations

# ── BOT SETTINGS (optional) ──
BOT_NAME=My Agent
MAX_HISTORY=10
# Fallback cooldown after a failed call. A 429 that names its own reset
# window (Retry-After / x-ratelimit-reset-*) uses that instead — this only
# applies when the provider says nothing.
ROUTER_COOLDOWN_SECONDS=90
# Free routes cap tokens per minute long before tokens per day, and the agent
# loop fires its calls back to back. The router tracks the minute window and
# waits up to this long for it to roll rather than spending a 429.
ROUTER_MAX_TPM_WAIT_SECONDS=20
# Per-route minute ceilings as substring:number. Groq (12,000 tok / 30 req)
# and Gemini (250,000 tok / 10 req) free tiers are built in; both ceilings are
# checked, because a route can have tokens to spare and no requests left.
# ROUTER_TPM_LIMITS=groq:12000,gemini:250000
# ROUTER_RPM_LIMITS=groq:30,gemini:10
# Slack reaction shown while the bot is thinking; use "" to disable.
LOADING_REACTION=hourglass_flowing_sand

# ── OPTIONAL PRIMARY/BACKUP PROVIDER KEYS ──
# Add free keys here only if you want stronger reliability. The built-in
# router tries healthy routes and automatically cools down failed ones.
# NVIDIA_API_KEY=nvapi-your-key
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ── MERGE GATEWAY (optional paid gateway) ──
# Get the mg_... key from https://gateway.merge.dev
# The $10 credit is consumed according to the provider/model you select.
# MERGE_GATEWAY_API_KEY=mg_your_key
# MERGE_GATEWAY_MODEL=openai/gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# OPTIONAL BACKUP BRAINS (leave empty = disabled)
# Every route the router knows about. Add a key and it joins the rotation
# automatically; paid routes are always tried last. Each has a matching
# *_MODEL override if the default model name is retired.
#
# GEMINI_API_KEY=        (free: https://aistudio.google.com/apikey)
#                        The ONLY vision route — image understanding needs it.
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=          (free: https://console.groq.com/keys)
# GROQ_MODEL=llama-3.3-70b-versatile
# MISTRAL_API_KEY=       (free: https://console.mistral.ai/api-keys)
# MISTRAL_MODEL=mistral-small-latest
# SAMBANOVA_API_KEY=     (free: https://cloud.sambanova.ai)
# SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
# XAI_API_KEY=           (https://console.x.ai)
# XAI_MODEL=grok-3-mini-fast
# CEREBRAS_API_KEY=      (free: https://cloud.cerebras.ai)
# CEREBRAS_MODEL=llama-3.3-70b
# TOGETHER_API_KEY=      (https://api.together.xyz)
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# COHERE_API_KEY=        (https://dashboard.cohere.com/api-keys)
# COHERE_MODEL=command-r-plus
# OPENROUTER_API_KEY=    (https://openrouter.ai/keys)
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# HF_API_KEY=            (https://huggingface.co/settings/tokens)
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
#
# ── ANY OpenAI-compatible endpoint: Ollama, LM Studio, vLLM, LiteLLM, a
#    gateway, or a local model once this moves to self-hosted hardware.
# CUSTOM_LLM_URL=http://127.0.0.1:8000/v1/chat/completions
# CUSTOM_LLM_API_KEY=    (optional for a local server)
# CUSTOM_LLM_MODEL=default
# CUSTOM_LLM_NAME=Custom endpoint
# ─────────────────────────────────────────────────────────────

# ── BOT BEHAVIOUR (optional) ──
# Replace the whole system prompt. Leave unset to keep the built-in one,
# which the operating manual is appended to.
# SYSTEM_PROMPT=
# Condense a thread into a rolling digest every N new messages.
# SUMMARY_EVERY=12
# How often a worker looks for queued runs, in seconds.
# RUN_POLL_SECONDS=2

# Writing to this server's disk or to a repo clone on it (write_file,
# clone_repo, repo_write_file, repo_edit_file, repo_check, scaffold_site) is
# owner-only by default. A stranger writing files the owner may later push is
# a supply-chain step, not a chat feature. Set this to false only in a
# workspace where everyone is trusted.
# WORKSPACE_WRITES_OWNER_ONLY=true

# ── OWNER LOCK (required once the bot is reachable by more than just you) ──
# Your Slack user ID. Tools that change external state on your behalf
# (github_write_file, github_create_issue, restart_service,
# push_branch) only run for this Slack user — anyone
# else gets a polite refusal instead of the tool executing with your
# credentials.
# Find your ID in Slack: profile -> More -> Copy member ID.
# OWNER_SLACK_ID=U0XXXXXXX

# ── SKILLS: GITHUB AUTOMATION + CODING WORKSPACE (optional) ──
# A fine-grained personal access token (repo contents + issues read/write)
# lets the agent read files/issues via the API and propose changes as a
# pull request (it never commits straight to main) — for a single file via
# github_write_file, or for a whole cloned repo via clone_repo + push_branch
# (needed because plain `git push` has no credential helper on this server;
# push_branch authenticates the push itself without storing the token
# anywhere on disk).
# GITHUB_TOKEN=github_pat_your_token
# GITHUB_DEFAULT_OWNER=your-github-username
# GITHUB_DEFAULT_REPO=your-default-repo

# ── SKILLS: SERVER ADMINISTRATION (optional) ──
# Comma-separated systemd services the agent is allowed to restart via the
# restart_service tool. Requires passwordless sudo for exactly this command,
# e.g. via: sudo visudo -f /etc/sudoers.d/my-agent
#   denis94uk ALL=(ALL) NOPASSWD: /bin/systemctl restart my-agent.service
# ALLOWED_SERVICES=my-agent.service

# ── SKILLS: WEBSITE BUILDING (optional) ──
# ─────────────────────────────────────────────────────────────

# ── AUTONOMY: BACKGROUND RUNS + SCHEDULES ──
# Work that runs without a human in the loop. A "run" is a durable task:
# every step is written to SQLite, so a run survives a restart and resumes
# where it stopped instead of starting over.
#
# Runs start in three ways:
#   • you ask for background work        → start_background_run tool
#   • a schedule fires                   → schedule_task tool, /schedules
#   • a plan goes quiet with open steps  → resumed automatically
#
# Slack: /runs to list, /runs <id> for detail, /runs cancel <id> to stop.

# How many runs execute at once. 2 is plenty on a 1 GB instance.
# RUN_WORKERS=2

# Per-run budgets. A run stops at whichever it hits first, then reports
# what it got done rather than dying silently.
# RUN_MAX_STEPS=25
# RUN_MAX_SECONDS=900

# Safety cap on runs the bot starts *by itself* (schedules + plan resumes)
# in any 24h window. Runs you ask for directly are never blocked by it.
# Set 0 to disable the cap.
# RUN_DAILY_LIMIT=50

# How often the scheduler checks for due schedules and stalled plans.
# SCHEDULER_ENABLED=true
# SCHEDULER_TICK_SECONDS=30

# Automatic plan resumption: if a plan still has open steps and BOTH the
# plan and its Slack thread have been idle this long, the bot picks the
# work back up on its own. The idle check is what stops it from talking
# over someone who is still typing.
# PLAN_AUTO_RESUME=true
# PLAN_STALE_SECONDS=600
# PLAN_MAX_RESUMES=3
#
# NOTE ON UNATTENDED SAFETY: the OWNER_SLACK_ID lock above answers "is the
# human asking right now the owner?" — which means nothing when a cron job
# is the caller. So unattended runs additionally refuse every owner-only
# tool (deploy, push, service restart) and can never create more schedules
# or runs. They do the work up to that line and report what needs a human.
# ─────────────────────────────────────────────────────────────

# ── CRITIC GATE ──
# A second AI pass that re-reads the goal, the tool transcript, and the
# proposed answer, then returns ACCEPT or REVISE + a specific reason. REVISE
# goes back into the loop as another turn. It exists to catch the failure
# this bot has actually shipped before: an answer claiming work the
# transcript does not show happening ("I saved it" with no write_file call).
#
# Two deliberate behaviours: an unparseable or erroring critic ACCEPTS (a
# broken grader must not trap finished work), and an honestly-reported
# blocker — blocked tool, missing token, needs a human — counts as DONE, so
# the gate can't loop demanding the impossible.
#
# On background/unattended runs (nobody is reading the result).
# CRITIC_ENABLED=true
#
# Also on live Slack replies. Off by default: costs an extra AI call per
# turn, and a human is right there to push back themselves.
# CRITIC_INTERACTIVE=false
#
# Revision rounds before the work ships anyway with the unresolved critique
# attached to the result. Each critic call counts against RUN_MAX_STEPS.
# CRITIC_MAX_ROUNDS=2
# ─────────────────────────────────────────────────────────────

# ── LONG-RUN SURVIVAL (context, retries, overlap) ──
# Fold the transcript into a progress note once it passes this many
# characters (~4 chars/token, so 24000 ≈ 6k tokens of TRANSCRIPT), keeping the
# goal and the last few turns verbatim.
#
# This is the transcript budget only. The system prompt rides on top of every
# call and is ~35k chars / ~8.8k tokens (base prompt + operating manual + tool
# descriptions + playbooks), so worst case is ~15k tokens per call and a route
# needs >= 16k context. The shipped routes are 128k-class so the default is
# fine; lower this if you add a small local model. The bot logs the real
# figures at startup. Without this a 25-step run overflows an 8k-context
# model and dies late, having done most of the work. The fold is persisted,
# so a resumed run rebuilds the compacted history, not the original.
# Falls back to a no-AI deterministic digest if the summariser fails — the
# router being down is exactly when a long run still needs to keep going.
# RUN_CONTEXT_LIMIT_CHARS=24000

# Retries for a run that *errored* (distinct from the process crashing, which
# is always resumed). Backoff doubles each attempt: 60s, then 120s. Config
# errors are never retried — they fail identically forever.
# RUN_MAX_RETRIES=2
# RUN_RETRY_BACKOFF_SECONDS=60

# By default a schedule will not start a second run while its previous one is
# still going — a slow run delays the next fire instead of stacking a backlog
# that would run all at once. On a 1 GB box that stacking is how you lose the
# process. Set true only if overlapping runs are genuinely what you want.
# SCHEDULE_ALLOW_OVERLAP=false
# ─────────────────────────────────────────────────────────────

# ── GOVERNOR: APPROVALS + COST ──
# Every tool has a risk tier: read / write_local / external. In an unattended
# run, an EXTERNAL tool (deploy, push, restart, schedule) does not fail and
# does not proceed — the run PAUSES on disk, asks in Slack, and waits.
#   /approvals        what's waiting
#   /approve <id>     run it, exactly as requested
#   /deny <id> <why>  refuse it; the agent finishes without it
# Only OWNER_SLACK_ID can decide. Read and local-write tools are never gated:
# asking permission to run `ls` teaches people to approve without reading.
# A schedule with allow_risky set skips the queue (pre-authorised).
# APPROVALS_ENABLED=true
#
# Unanswered requests expire — and expiry is a DENY, never a yes. The run is
# unparked so it can report that it never got an answer. Default 24h.
# APPROVAL_TIMEOUT_SECONDS=86400
#
# Switching approvals off restores the old behaviour: external tools are a
# flat no in unattended runs, because there is nobody to ask.

# ── Cost accounting ──
# AI calls are counted per provider per day (`/costs`). Free routes are
# best-effort; a paid backup is a real monthly budget, and an agent that
# starts its own work can spend it while nobody is watching. Name the paid
# routes (substring match on the provider name) and cap them per day — past
# the cap they drop out of rotation and free routes still serve, so the bot
# degrades instead of stopping.
# PAID_PROVIDERS=merge
# PAID_DAILY_LIMIT=200
# ─────────────────────────────────────────────────────────────

# ── STUCK-RUN WATCHDOG ──
# A run's wall-clock budget is only checked *between* steps, so a run hung
# inside a tool call never reaches it — it stays 'running' forever, and
# 'running' counts as active, which blocks that schedule from firing again.
# The scheduler tick fails any run that has gone this long without a
# heartbeat. Generous by default: one tool call can legitimately take minutes
# (a pytest quality gate, a slow clone).
#
# It does NOT re-queue the run — the worker thread may still be alive inside
# that tool and Python cannot safely kill it, so re-queueing would run the
# same steps twice. The run is failed, the leaked worker is logged loudly,
# and a restart reclaims the thread.
# RUN_STUCK_SECONDS=1800
# ─────────────────────────────────────────────────────────────
