# ╔══════════════════════════════════════════════════════════╗
# ║        My-Agent-Mini — Environment Variables            ║
# ║  Copy this to .env and fill in your keys                ║
# ╚══════════════════════════════════════════════════════════╝

# ── SLACK (required) ──
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# ── BOT SETTINGS ──
BOT_NAME=My Agent
MAX_HISTORY=10

# ── AI PROVIDERS (add at least one!) ──
# Providers are tried in order. Set only the ones you have.
# Get free API keys from:

# 1. Google Gemini (FREE — 15 requests/min, 1M tokens/day)
#    Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# 2. Groq (FREE — 30 requests/min, ultra-fast)
#    Get key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 3. xAI / Grok (FREE tier — 60 requests/min)
#    Get key: https://console.x.ai
XAI_API_KEY=
# XAI_MODEL=grok-3-mini-fast

# 4. Cerebras (FREE — ultra-fast inference)
#    Get key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

# 5. SambaNova (FREE — fast inference)
#    Get key: https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
# SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# 6. Together AI (FREE $5 credit)
#    Get key: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# 7. Mistral (FREE tier)
#    Get key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# 8. Cohere (FREE — 20 requests/min)
#    Get key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# COHERE_MODEL=command-r-plus

# 9. OpenRouter (FREE models available)
#    Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# 10. HuggingFace (FREE tier)
#     Get key: https://huggingface.co/settings/tokens
HF_API_KEY=
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
