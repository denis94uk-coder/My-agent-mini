# ╔══════════════════════════════════════════════════════════╗
# ║   My-Agent-Mini v5 — Built-in smart AI router             ║
# ║   Copy this to .env and fill in Slack keys               ║
# ╚══════════════════════════════════════════════════════════╝

# ── SLACK (required — how the bot connects to Slack) ──
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# ── KEYLESS BEST-EFFORT ROUTE (enabled by default) ──
# Pollinations provides an anonymous community route. It may be slow,
# rate-limited, or unavailable; it is not guaranteed or unlimited.
POLLINATIONS_ENABLED=true
POLLINATIONS_MODEL=openai-fast
# Keep true so an old/expired provider key cannot block the free route.
ROUTER_PREFER_KEYLESS=true

# ── BOT SETTINGS (optional) ──
BOT_NAME=My Agent
MAX_HISTORY=10
ROUTER_COOLDOWN_SECONDS=90

# ── OPTIONAL PRIMARY/BACKUP PROVIDER KEYS ──
# Add free keys here only if you want stronger reliability. The built-in
# router tries healthy routes and automatically cools down failed ones.
# NVIDIA_API_KEY=nvapi-your-key
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ── MERGE GATEWAY (optional paid gateway) ──
# Get the mg_... key from https://gateway.merge.dev
# The $10 credit is consumed according to the provider/model you select.
# MERGE_GATEWAY_API_KEY=mg_your_key
# MERGE_GATEWAY_MODEL=openai/gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# OPTIONAL BACKUP BRAINS (leave empty = disabled)
# If NVIDIA ever fails or runs out of free calls, add one of
# these and the bot will use it automatically as backup:
#
# GROQ_API_KEY=          (free: https://console.groq.com/keys)
# MISTRAL_API_KEY=       (free: https://console.mistral.ai/api-keys)
# SAMBANOVA_API_KEY=     (free: https://cloud.sambanova.ai)
# ─────────────────────────────────────────────────────────────
